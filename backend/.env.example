# Copie para .env e ajuste os valores.
# Banco de dados
DATABASE_URL=postgres://postgres:postgres@localhost:5432/paroquia

# Segurança: gere com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=troque-por-um-segredo-longo-aleatorio

# Ambiente: development | test | production
NODE_ENV=development

# Porta do servidor API
PORT=3000

# Origem permitida no CORS (frontend). Separe múltiplas com vírgula.
CORS_ORIGIN=http://localhost:5173

# Permite criar usuário administrador via POST /api/auth/register (bootstrap).
# Deixe false em produção.
AUTH_REGISTER_OPEN=true

# Usado pelo script de seed (npm run db:seed)
BOOTSTRAP_ADMIN_NOME=Administrador
BOOTSTRAP_ADMIN_EMAIL=admin@paroquia.local
BOOTSTRAP_ADMIN_SENHA=trocar-senha-123