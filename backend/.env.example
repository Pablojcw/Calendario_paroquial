# Copie para .env e ajuste os valores.
# Banco de dados
DATABASE_URL=postgres://postgres:postgres@localhost:5432/paroquia

# Segurança: gere uma chave forte com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=sua-chave-jwt-secreta-longa-e-aleatoria-gerada

# Ambiente: development | test | production
NODE_ENV=development

# Porta do servidor API
PORT=3002

# Origem permitida no CORS (frontend). Separe múltiplas com vírgula.
CORS_ORIGIN=http://localhost:5173

# Permite criar usuário administrador via POST /api/auth/register (bootstrap inicial).
# Deixe false em produção.
AUTH_REGISTER_OPEN=false

# Usado pelo script de seed / bootstrap
BOOTSTRAP_ADMIN_NOME=Administrador Paroquial
BOOTSTRAP_ADMIN_EMAIL=secretaria@paroquia.local
BOOTSTRAP_ADMIN_SENHA=coloque_aqui_uma_senha_forte_e_segura